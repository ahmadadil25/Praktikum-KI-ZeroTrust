    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "http-proxy-middleware": "^3.0.10",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
