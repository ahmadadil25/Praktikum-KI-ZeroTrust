    "start:transkrip": "node service-transkrip/server.js",
    "seed": "node database/seed.js",
    "reset": "node database/reset.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js"
  },
  "keywords": [
    "zero-trust",
    "nist-sp-800-207",
    "pep",
    "pdp",
    "api-gateway",
    "express",
