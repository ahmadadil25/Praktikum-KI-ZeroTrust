{
  "name": "zero-trust-sistem-nilai",
  "version": "1.0.0",
  "description": "Backend Sistem Pengelolaan Nilai Akademik berbasis Arsitektur Zero Trust Security (NIST SP 800-207)",
  "main": "gateway/server.js",
  "scripts": {
    "start": "node scripts/start-all.js",
    "start:gateway": "node gateway/server.js",
