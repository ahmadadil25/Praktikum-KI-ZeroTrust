      "item": [
        {
          "name": "1.1 Login Dosen Budi (Valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('tokenDosenBudi', res.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.refresh_token);",
                  "}",
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token access diterbitkan', () => pm.expect(res.access_token).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Device-ID",
                "value": "DEV-DOSEN-01"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dosen_budi\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
