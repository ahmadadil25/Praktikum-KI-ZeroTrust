# Zero Trust Security - Sistem Nilai Environment Variables
# Port Services
PORT_GATEWAY=3000
PORT_NILAI=3001
PORT_TRANSKRIP=3002

# Internal Service URLs
SERVICE_NILAI_URL=http://localhost:3001
SERVICE_TRANSKRIP_URL=http://localhost:3002
GATEWAY_URL=http://localhost:3000

# Secrets JWT
JWT_ACCESS_SECRET=[REDACTED-SECRET]
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_SECRET=[REDACTED-SECRET]
JWT_REFRESH_EXPIRES_IN=1d
JWT_SERVICE_SECRET=[REDACTED-SECRET]
JWT_SERVICE_EXPIRES_IN=5m

# Gateway Secret (disisipkan PEP saat meneruskan request ke Service Nilai & Transkrip)
GATEWAY_SECRET=[REDACTED-SECRET]

# Kredensial Service-to-Service (Service Nilai memanggil Gateway /auth/service)
SERVICE_CLIENT_ID=service-nilai-client
SERVICE_CLIENT_SECRET=[REDACTED-SECRET]

# Konfigurasi Database SQLite
DB_PATH=./data/database.sqlite

# Kebijakan Jam Akses (WIB / Asia/Jakarta)
ACCESS_HOURS_START=7
ACCESS_HOURS_END=21
ACCESS_TIMEZONE=Asia/Jakarta

